MODE=dev

#Sentry
SENTRY_ENV=production
SENTRY_DSN=https://fakePublicKey@fake.ingest.sentry.io/123456
SENTRY_ENABLED=false

# URL of RPC node
WEB3=http://localhost:8545
UI_BASE_URL=http://localhost:4200

CERTIFICATE_REGISTRY_ADDRESS=
ISSUER_CONTRACT_ADDRESS=

# Debug key used to trigger `/debug/*` endpoints (refer to swagger for endpoint docs)
DEBUG_API_KEY=debug

# --- Port used by backend to run the server --- #
BACKEND_PORT=3040

# --- DATABASE --- #
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=origin

# --- DATABASE REPLICA --- #
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5432

# --- AUTH ---
# Secret phrase used to encrypt JWT tokens
JWT_SECRET=thisisnotsecret
JWT_API_USER_SECRET="my-secret"

# Token expiration tim
JWT_EXPIRY_TIME="7 days"

# --- BLOCKCHAIN ---#
# Blockchain wallet private access key
ISSUER_PRIVATE_KEY=

# Blockchain address
DREC_BLOCKCHAIN_ADDRESS=

# Delay (in ms) between processing blockchain commands (issue, claim, transfer)
CERTIFICATE_QUEUE_DELAY=20000
ISSUE_BATCH_SIZE=4
MAX_SYNCHRONIZATION_ATTEMPTS_FOR_EVENT=8

# --- SMART METER READINGS --- #
# InfluxDB configuration variables
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=admin:admin
INFLUXDB_ORG=
INFLUXDB_BUCKET=energy/autogen

# Optional for influxdb-init.sh script
INFLUXDB_DB=energy
INFLUXDB_ADMIN_USER=test
INFLUXDB_ADMIN_PASSWORD=test
INFLUXDB_USER=api
INFLUXDB_USER_PASSWORD=secret



# Supported networkd ID's used by Metamask, separating them by a semicolon ';'
REACT_APP_ISSUER_ADDRESS=0x28130b5603cfcd597862a1F6786AbFEgrr645430Ddc2B92F
REACT_APP_SUPPORTED_NETWORK_IDS=246
REACT_APP_BLOCKCHAIN_EXPLORER_URL=https://volta-explorer.energyweb.org

# ------- OPTIONAL UI variables ------- #
REACT_APP_GOOGLE_MAPS_API_KEY=<API_KEY>
REACT_APP_REGISTRATION_MESSAGE_TO_SIGN='I register as D-REC Origin user'


# Redis URL
REDIS_URL=

# --- MAIL CONFIG ---
SMTP_HOST='smtp.gmail.com'
SMTP_PORT=587
SMTP_LOGIN='247-demo@energyweb.org'
SMTP_PASSWORD=****************
EMAIL_FROM_NAME=D-REC
EMAIL_FROM=no-reply@drecs.org


REGISTRATION_MESSAGE_TO_SIGN='I register as D-REC Origin user'

# BBOX developer connection data to pull reads for BBOX devices
BBOX_USERNAME=
BBOX_PASSWORD=
BBOX_SERVER=
BBOX_AUTH_SERVER=

# S3 Bucket
accessKeyId=
secretAccessKey=
region=
bucketname=

# IREC EVIDENT
IREC_EVIDENT_API_URL="https://api.sandbox.evident.dev"
IREC_EVIDENT_REGISTRANT_EMAIL=
IREC_EVIDENT_Password=
IREC_EVIDENT_API_Token=
IREC_EVIDENT_ISSUER_ID=

# This should be a 32 character hex string
# Generated using `openssl rand -hex 16`
ENCRYPTION_SECRET="770A8A65DA156D24EE2A093277530142"

# DEFAULT ADMIN CREDENTIAL
ADMIN_EMAIL=
ADMIN_PASSWORD=